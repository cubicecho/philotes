{
  "name": "@philotes/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --preserve-symlinks --env-file=../.env --watch src/index.ts",
    "build": "echo 'no server build needed'",
    "start": "node --preserve-symlinks src/index.ts",
    "clean": "rm -rf __generated__",
    "codegen": "node --import=./src/preload-env.ts src/write-schema.ts && graphql-codegen-esm"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@philotes/db": "*",
    "@vantreeseba/drizzle-graphql": "^9.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-scalars": "^2.0.0",
    "ical-generator": "^10.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0"
  }
}
