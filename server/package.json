{
  "name": "@cubicecho/philotes-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "clean": "rm -rf __generated__",
    "codegen": "node --import=./src/core/preload-env.ts src/graphql/write-schema.ts && graphql-codegen-esm"
  },
  "dependencies": {
    "@cubicecho/philotes-db": "*",
    "@vantreeseba/drizzle-graphql": "^9.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.2",
    "ical-generator": "^10.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
