{
  "name": "@cubicecho/philotes-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_NO_DEVTOOLS=1 npx expo start --port 8081",
    "build": "expo export --platform web",
    "build:android": "expo export --platform android --output-dir dist-android",
    "android": "EXPO_NO_DEVTOOLS=1 npx expo start --dev-client --port 8081",
    "android:build": "eas build --profile development --platform android",
    "preview": "npx serve dist",
    "clean": "rm -rf src/__generated__ node_modules .expo",
    "codegen": "graphql-codegen-esm"
  },
