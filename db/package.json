{
  "name": "@cubicecho/philotes-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./relations": "./src/relations.ts",
    "./api-keys": "./src/api-keys.ts",
    "./wait": "./src/wait.ts",
    "./defaults": "./src/defaults.ts"
  },
  "scripts": {
