# Where Postgres is. Required. `npm run db:up` starts the one this URL points at.
DATABASE_URL=postgres://philotes:philotes@localhost:5439/philotes

# Secret used to sign sign-in tokens. Required in production, where a short or default value stops the boot.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Public URL the app is served at. Sign-in links are built from it, and browsers on any other origin are refused.
# Default: http://localhost:<PORT>
APP_URL=http://localhost:3001

# Port the server listens on. Default 3001.
# PORT=3001

# How long the server waits for Postgres at boot before giving up, in ms. Default 60000.
# DB_CONNECT_TIMEOUT_MS=60000

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy (Caddy, Traefik, nginx); or "loopback", "uniquelocal", or a list of addresses.
# Never "true" when the port is reachable from the internet: any client could then choose its own address.
# TRUST_PROXY=1

# The dev Postgres's host port, read by docker-compose.dev.yml. Default 5439.
# POSTGRES_PORT=5439

# The interface the dev Postgres binds. Default 127.0.0.1. Set 0.0.0.0 when the Docker daemon is remote.
# DEV_BIND=0.0.0.0

# Set to "production" in Docker (already set in the Dockerfile).
# NODE_ENV=production
