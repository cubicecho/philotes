# Where Postgres is. Required. `npm run db:up` starts the one this URL points at.
DATABASE_URL=postgres://philotes:philotes@localhost:5439/philotes

# Secret that signs sessions. Required in production, where a short or default value stops the boot.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL the app is served at. Sign-in links are built from it, and browsers on any other origin are refused.
# Default: http://localhost:<PORT>
APP_URL=http://localhost:3000

# Sign any email in at once, with no password and no link. Default false.
# Only for an instance on a private network: the boot refuses it when APP_URL is a public address.
# SECURE_LOCAL_NET=true

# Accept SECURE_LOCAL_NET with a public APP_URL. Default false.
# Unsafe: anyone who can reach the port can then sign in as anyone.
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=true

# Where sessions are kept. "memory" (default) signs everyone out on restart; "database" keeps them in Postgres.
# SESSION_STORE=database

# SMTP server for sign-in links, such as smtp://user:pass@smtp.example.com:587. Unset, the sign-in page
# offers passwords only.
# SMTP_URL=

# The From address of those emails. Default philotes@<APP_URL host>.
# SMTP_FROM=

# Port the server listens on, and the host port docker-compose.yml publishes. Default 3000.
# PORT=3000

# Directory uploaded avatars are kept in. Default ./avatars at the repo root; the Docker image uses /data/avatars.
# AVATAR_DIR=/data/avatars

# Password of the Postgres that docker-compose.yml runs. Default philotes. Nothing outside the stack reaches it.
# POSTGRES_PASSWORD=philotes

# How long the server waits for Postgres at boot before giving up, in ms. Default 60000.
# DB_CONNECT_TIMEOUT_MS=60000

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy (Caddy, Traefik, nginx); or "loopback", "uniquelocal", or a list of addresses.
# Sign-in rate limits key on the client address, so get this right behind a proxy.
# Never "true" when the port is reachable from the internet: any client could then choose its own address.
# TRUST_PROXY=1

# The dev Postgres's host port, read by docker-compose.dev.yml. Default 5439.
# POSTGRES_PORT=5439

# The interface the dev Postgres binds. Default 127.0.0.1. Set 0.0.0.0 when the Docker daemon is remote.
# DEV_BIND=0.0.0.0

# Set to "production" in Docker (already set in the Dockerfile).
# NODE_ENV=production
